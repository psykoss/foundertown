# Copy to .env (repo root). One file for the client, the server and the landing page.
# Without the two Supabase values everything runs in guest mode (no sign-in) — dev only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings → API keys → publishable key (older projects: the anon key, as VITE_SUPABASE_ANON_KEY).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Multiplayer server origin as the browser reaches it. Default: this host on port 2567.
# VITE_SERVER_URL=http://localhost:2567   (production: https://api.thefoundertown.com)
# Where the game client is served (invite links, CORS, the landing page's "Join now").
# APP_URL=http://localhost:5173          (production: https://thefoundertown.com)
# VITE_APP_URL=http://localhost:5173
# PORT=2567

# Optional: invite emails through https://resend.com. Without it invites open the sender's mail app.
# RESEND_API_KEY=
# MAIL_FROM=Founder Town <hello@yourdomain.com>

# Optional: WebRTC ICE servers as JSON. Add a TURN server for production so calls work behind strict firewalls.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
