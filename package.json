{
  "name": "founder-town",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter @ft/server dev",
    "build": "pnpm assets && pnpm --filter client build",
    "assets": "pnpm assets:placeholders && pnpm assets:map && pnpm assets:validate",
    "assets:placeholders": "tsx scripts/gen-placeholders.ts",
    "assets:map": "tsx scripts/gen-map.ts",
    "assets:validate": "tsx scripts/validate-assets.ts",
    "assets:export": "bash scripts/export-aseprite.sh",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p client --noEmit && tsc -p server && tsc -p landing",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter @ft/server dev",
    "start:server": "pnpm --filter @ft/server start",
    "dev:landing": "pnpm --filter landing dev",
    "build:landing": "pnpm --filter landing build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
