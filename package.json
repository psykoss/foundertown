{
  "name": "founder-town",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run art:build",
    "prebuild": "npm run art:build",
    "dev": "npm run dev -w @founder-town/client",
    "build": "tsc -b && npm run build -w @founder-town/client",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "art:build": "tsx packages/art/tools/build.ts",
    "art:preview": "vite packages/art/tools/preview",
    "art:export": "tsx packages/art/tools/export-png.ts",
    "art:measure": "tsx packages/art/tools/measure-ref.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
